NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bug_bounty
DIRECT_URL=postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require
# Leave empty to run without Redis
REDIS_URL=
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

# Google Cloud OAuth client ID used to verify Google ID tokens
GOOGLE_CLIENT_ID=

# Stripe test-mode keys from the Stripe dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Password for the seeded admin account. Set a strong value in production
SEED_ADMIN_PASSWORD=
